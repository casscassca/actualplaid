# Your Plaid keys, which can be found in the Plaid Dashboard.
# https://dashboard.plaid.com/account/keys
PLAID_CLIENT_ID=

PLAID_SECRET_DEVELOPMENT=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# The Plaid environment to use ('sandbox', 'development', or 'production').
# https://plaid.com/docs/#api-host

PLAID_ENV=production
# Country codes in capital letters, comma-separated. 
PLAID_COUNTRY_CODES="US,CA"
PLAID_PRODUCTS="transactions,investments"
PLAID_LANGUAGE="en"

ACTUAL_SERVER_URL="http://localhost:5006" 
ACTUAL_SERVER_PASSWORD=
ACTUAL_SERVER_ENCRYPTION_PASSWORD="" 
ACTUAL_BUDGET_ID=

# Webapp Information
APP_PORT=3001
APP_BIND_ADDRESS=127.0.0.1

# URL this tool will run on, for linking accounts. Requires https for oAUTH (https://example.com).
APP_URL="http://localhost"

# Questrade initial refresh tokens (one per Questrade login, from API Centre > New manual authorization)
# Only used to seed; after first run the rotated token lives in questrade-token-<name>.json
CASS_QUESTRADE=                  
JASON_QUESTRADE=